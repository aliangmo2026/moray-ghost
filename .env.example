# moray-ghost 配置示例：复制为 .env 后按需修改。
# 注意：GHOST_TOKEN 留空时，首次启动会自动生成随机 token 并写回 .env（.env 已 gitignore）。
GHOST_HOST=127.0.0.1
GHOST_PORT=8030
GHOST_TOKEN=
# Intent Token（HMAC + nonce 防重放）开关；开启后可用 intent.<payload>.<sig> 形式的 token。
GHOST_INTENT_TOKEN_ENABLED=false
# HMAC 密钥；留空则复用 GHOST_TOKEN 作为签名密钥。
GHOST_HMAC_KEY=
# /screenshot 与动作返回图的 JPEG 默认质量（10..95）
GHOST_JPEG_QUALITY=70
