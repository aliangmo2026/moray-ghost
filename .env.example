# moray-ghost 配置示例：复制为 .env 后按需修改。
# 注意：GHOST_TOKEN 留空时，首次启动会自动生成随机 token 并写回 .env（.env 已 gitignore）。
GHOST_HOST=127.0.0.1
GHOST_PORT=8030
GHOST_TOKEN=
# Intent Token（HMAC + nonce 防重放）开关；开启后可用 intent.<payload>.<sig> 形式的 token。
GHOST_INTENT_TOKEN_ENABLED=false
# HMAC 密钥；留空则复用 GHOST_TOKEN 作为签名密钥。
GHOST_HMAC_KEY=
# /screenshot 与动作返回图的 JPEG 默认质量（10..95）
GHOST_JPEG_QUALITY=70
# 多 Agent 队列：SDK/调用方默认 X-Agent-Id（客户端约定，服务端无此配置项）。
GHOST_AGENT_ID=
# 运行环境标识（v0.7.1）：dev（默认，宽松，本地联调）/ production
# （生产：动作必须来自带 Token 的合法 HTTP 调用链，进程内旁路一律 403 SOURCE_DENIED）。
GHOST_ENV=dev
# 全局急停热键（v0.7.1）：系统级、按下即释放输入并退出进程；留空禁用。
GHOST_ESTOP_HOTKEY=ctrl+alt+q
# ---- v0.7.2 极限安全 ----
# 动作硬超时（秒）：锁等待与执行两段预算；超时 → 强制释放按键鼠标 + 冻结 + 408。
GHOST_ACTION_TIMEOUT=10
# 动作频率熔断（防 AI 死循环）：同一指纹窗口内超限 / 连续重复超限 → 429 + 冻结。
GHOST_RATE_LIMIT_COUNT=10
GHOST_RATE_LIMIT_WINDOW=1.0
GHOST_RATE_LIMIT_CONSECUTIVE=50
# 独立看门狗（主进程被强杀后物理释放修饰键）；true/false。
GHOST_WATCHDOG=true
# ---- v0.8.0 MCP 多模态感知（VL Driver） ----
# 感知后端：auto（默认：llama 可用→llama，否则 ocr，否则 native）|
# native（win32 枚举）| ocr（rapidocr 本地视觉模型）| llama（GGUF 真模型）| mock。
GHOST_VL_BACKEND=auto
# 模型档位：2b / 7b；路径按档位读取 GHOST_VL_MODEL_PATH_<PROFILE>。
GHOST_VL_MODEL_PROFILE=2b
# 真实 VL 模型权重（GGUF，如 Qwen2-VL-2B / 7B）；对应档位留空=未接入。
GHOST_VL_MODEL_PATH_2B=
GHOST_VL_MODEL_PATH_7B=
# 多模态投影器 mmproj（llama.cpp 视觉必需，与模型配套；详见 docs/MCP_接入指南.md）。
GHOST_VL_MMPROJ_PATH_2B=
GHOST_VL_MMPROJ_PATH_7B=
# GPU offload 层数（-1=全量；CPU 版 llama-cpp 轮子忽略，CUDA 轮子生效）。
GHOST_VL_N_GPU_LAYERS=-1
# 送模型的最长边（CPU 640≈20s/次；CUDA 可 1024/1280）。
GHOST_VL_MAX_SIDE=1024
# llama.cpp 0.4.5+ Qwen-VL grounding 建议的最小图像 token（0.3.36 忽略）。
GHOST_VL_IMAGE_MIN_TOKENS=1024
# 混合图标定位（CV 粗筛 + 编号网格 + VL 选号）：auto=仅 7b 档启用；
# 1/true=强制启用；0/false=关闭。7B 实测仍会把「矩形」选成圆角/菱形
# （confidence 0.99），因此示例默认关闭；实验时改 1 或 auto。
GHOST_VL_HYBRID=0
GHOST_VL_HYBRID_MIN_CONF=0.55
# mock 后端夹具 JSON：[{"text":"确定","type":"button","bbox":[x,y,w,h]}]
GHOST_VL_MOCK_JSON=

# ---- v0.12.0 GUI RAG + Ghost Guard ----------------------------------------
# GUI RAG：OCR+CV+win32 检索编号元素表 → VLM 只回 {"target_id": N}（不产生坐标）。
# 送 VLM 的候选上限（文本相关度预筛，避免长目录拖慢 2B）。
GHOST_RAG_MAX_CANDIDATES=16
# VLM 选号置信度下限（模型未返回 confidence 时不施加门槛）。
GHOST_RAG_MIN_CONF=0.0
# 编号截图随 VLM 一起送：auto（图标/无文本候选时才带图）| always | never。
GHOST_RAG_IMAGE_MODE=auto
# 元素检索短 TTL 缓存（秒）：连续 ground_target 复用元素表，避免重复 OCR；
# 任何动作执行后立即失效。0=关闭。
GHOST_RAG_CACHE_SECONDS=2.0

# Ghost Guard 动态门禁：block（默认，命中高危词 → 409 PENDING_APPROVAL）| off。
GHOST_GUARD=block
# OCR 引擎不可用时：true（默认）= 拒绝点击（fail-closed）；false = 放行并审计。
GHOST_GUARD_FAIL_CLOSED=true
# 人类审批令牌：配置后，/execute_action 或 /browser/action 的 payload 带
# approval_token 且匹配才放行 PENDING_APPROVAL。
# **只放在人工控制台/审批服务环境，绝不要放进 Agent/MCP 的启动环境**。
GHOST_APPROVAL_TOKEN=

